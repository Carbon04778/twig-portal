# Copy to .env for local development. On Replit, set these as Secrets instead.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Emails that get the admin role (Donnell). Comma-separated, verified Clerk emails.
ADMIN_EMAILS=donnellkoh@gmail.com
# Set by Replit when Clerk is added to this Repl (Auth pane), or from your own Clerk app.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Sign-up details go to this Google Sheet through Replit's Google Sheets connection.
GOOGLE_SHEET_ID=
# Optional tab name. Leave out to use the first tab.
# GOOGLE_SHEET_TAB=Sign-ups
# HitPay. HITPAY_MODE=live uses real money; anything else uses HitPay's sandbox.
HITPAY_MODE=sandbox
HITPAY_API_KEY=
# The salt on the main Developers page.
HITPAY_SALT=
# The salt on the webhook's own page in HitPay (Developers > Webhook Endpoints).
HITPAY_WEBHOOK_SALT=
# PORT=3000
